<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<!-- IWebHostEnvironment (LocalEmployeePhotoStorageService) isn't in the old
		     Microsoft.AspNetCore.*.Abstractions NuGet packages (those predate IWebHostEnvironment,
		     which replaced IHostingEnvironment in ASP.NET Core 3.0) — the modern, correct way to
		     reference current ASP.NET Core types from a non-Web-SDK project is this shared
		     framework reference, not a legacy compat package. -->
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="AutoMapper" Version="16.1.1" />
		<!-- Service still queries through IQueryable<T> exposed by IRepository<T>, so it needs
		     EF Core's LINQ provider. This is a package dependency (like FluentValidation), not a
		     project reference to Infrastructure, so it no longer pulls in the concrete DbContext,
		     SQL Server provider, or migrations. Eliminating this entirely means replacing the
		     generic IRepository<T>/IQueryable pattern with entity-specific repositories or query
		     objects that own their .Include() graphs — a larger, separate refactor. -->
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.1" />
		<!-- Microsoft.Extensions.Configuration.Abstractions is no longer listed explicitly — the
		     FrameworkReference above already brings it in transitively (NU1510). -->
		<!-- Confirmed against the restored package: FirebaseAdmin.Messaging.FirebaseMessaging and
		     SendEachForMulticastAsync (used by FirebasePushNotificationSender) exist in 3.1.0. -->
		<PackageReference Include="FirebaseAdmin" Version="3.1.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\QZBarberShopBooking.Application\QZBarberShopBooking.Application.csproj" />
		<ProjectReference Include="..\QZBarberShopBooking.Domain\QZBarberShopBooking.Domain.csproj" />
	</ItemGroup>

</Project>
