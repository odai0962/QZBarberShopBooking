{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=QZBarberShopBookingDB;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=False;MultipleActiveResultSets=true;Connect Timeout=30;"
  },
  "JwtSettings": {
    "SecretKey": "YourSuperSecretKey123456789012345678901234567890",
    "Issuer": "QZBarberShop_API",
    "Audience": "QZBarberShop_Client",
    "ExpireMinutes": 60,
    "RefreshTokenExpireDays": 7
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "HH:mm:ss "
      }
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "PermitLimit": 100,
    "Window": 1,
    "QueueLimit": 0
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:4200",
      "https://yourdomain.com"
    ]
  }
}