{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "JwtSettings": {
    "SecretKey": "",
    "Issuer": "QZBarberShop_API",
    "Audience": "QZBarberShop_Client",
    "ExpireMinutes": 60,
    "RefreshTokenExpireDays": 7
  },
  "LoginEncryption": {
    "PrivateKey": ""
  },
  "Firebase": {
    "ServiceAccountKeyPath": ""
  },
  "NoShowCancellation": {
    "PollIntervalMinutes": 5,
    "ThresholdMinutes": 20
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "HH:mm:ss "
      }
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "PermitLimit": 100,
    "Window": 1,
    "QueueLimit": 0
  },
  "Caching": {
    "LongTermMinutes": 1440,
    "ShortTermMinutes": 15
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:4200"
    ]
  }
}
