{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=QZBarberShopBookingDB_Dev;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=False;MultipleActiveResultSets=true;"
  },
  "JwtSettings": {
    "SecretKey": "REPLACE_WITH_AT_LEAST_32_CHARACTERS_SECRET_KEY",
    "Issuer": "QZBarberShop_Dev",
    "Audience": "QZBarberShop_Dev_Client",
    "ExpireMinutes": 1440,
    "RefreshTokenExpireDays": 30
  },
  "LoginEncryption": {
    "PrivateKey": "REPLACE_WITH_PEM_RSA_PRIVATE_KEY (dotnet user-secrets set \"LoginEncryption:PrivateKey\" \"$(cat login_private_key.pem)\" --project QZBarberShopBooking.API)"
  },
  "Firebase": {
    "ServiceAccountKeyPath": "REPLACE_WITH_ABSOLUTE_PATH_TO_YOUR_FIREBASE_SERVICE_ACCOUNT_JSON"
  }
}
