{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    },
    "Console": {
      "LogLevel": {
        "Default": "Information"
      }
    }
  },
  "Swagger": {
    "Enabled": true,
    "RoutePrefix": "swagger"
  },
  "Caching": {
    "LongTermMinutes": 5,
    "ShortTermMinutes": 1
  }
}